{
    "name": "aisoft/laravel-scheduled-sequence",
    "description": "Persistent, state-aware scheduling sequences with irregular timing for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Goran Savkic"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/bus": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "AiSoft\\ScheduledSequence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiSoft\\ScheduledSequence\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AiSoft\\ScheduledSequence\\ScheduledSequenceServiceProvider"
            ]
        }
    },
    "scripts": {
        "check-autoload": "composer dump-autoload --optimize --strict-psr",
        "lint": "pint --test",
        "test": "phpunit",
        "check": [
            "@check-autoload",
            "@lint",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
